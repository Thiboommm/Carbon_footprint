<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_quote_collect_totals_before">
        <observer name="calculate_quote_carbon_footprint"
                  instance="Convert\CarbonFootprint\Observer\QuoteCarbonFootprint"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="transfer_carbon_to_order"
                  instance="Convert\CarbonFootprint\Observer\TransferCarbonFootprint"/>
    </event>
</config>
